# keiri-hisho 共通の環境変数（このファイルを .env にコピーして値を埋める。.env はgit管理外）
# Slack Incoming Webhook（全体通知チャンネル用）。自動化スクリプトの失敗通知・要確認通知に使う
GENERAL_SLACK_WEBHOOK_URL=
# 長時間作業の完了通知の投稿先（専用チャンネルにしたい場合。未設定なら GENERAL_SLACK_WEBHOOK_URL を使う）
LONG_TASK_SLACK_WEBHOOK_URL=
# 通知でメンションするオーナーのSlackユーザーID（例: U0XXXXXXXXX）  # leak-scan:allow
SLACK_MENTION_USER_ID=
# 長時間作業とみなすしきい値（分）
LONG_TASK_NOTIFY_MINUTES=1
