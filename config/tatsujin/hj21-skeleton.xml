          <IntangibleAssets Label="無形固定資産" Amount="" />
          <InvestmentsAndOtherAssets Label="投資その他の資産" Amount="" />
        </NoncurrentAssets>
        <DeferredAssets Label="繰延資産" Amount="" />
      </Assets>
      <Liabilities Label="負債の部" Amount="">
        <CurrentLiabilities Label="流動負債" Amount="" />
        <NoncurrentLiabilities Label="固定負債" Amount="" />
      </Liabilities>
      <NetAssets Label="純資産の部" Amount="" />
