<?xml version="1.0" encoding="UTF-8"?>
<!-- 構造の雛形。会計ソフトの実物（2026-10-26取得）から値をすべて消したもの。要素の並びだけを使う -->
<REPORT>
  <SYSTEM>
    <GYOUMUPREFIX>HJ21</GYOUMUPREFIX>
    <VERSION>1</VERSION>
    <FUNCTIONID>3</FUNCTIONID>
    <CONNECTEDPROGRAMVER />
    <PROGRAMNAME />
    <PROGRAMVER />
  </SYSTEM>
  <BASIC>
    <KOMONSAKINAME />
    <JIGYOUNENDOFROM />
    <JIGYOUNENDOTO />
    <PATTERN>
      <BS>
        <CA>
          <Doubtful>A2</Doubtful>
        </CA>
        <PPE>
          <DepImp>B5</DepImp>
        </PPE>
        <IOA>
          <Doubtful>C2</Doubtful>
          <DepImp>D5</DepImp>
        </IOA>
      </BS>
      <PL>
        <Sales>E1</Sales>
        <Cos>F3</Cos>
        <Sga>G1</Sga>
      </PL>
    </PATTERN>
  </BASIC>
  <DATA>
    <BalanceSheet>
      <Assets Label="資産の部" Amount="">
        <CurrentAssets Label="流動資産" Amount="" />
